# SITE_SCHEME controls auto-HTTPS. Default `http` so localhost / IP-based
# (LAN, VM) deploys serve plain HTTP — a bare host or IP makes Caddy issue an
# internal-CA cert the browser rejects (grynn-in/konsolidat#59). Production with
# a real DNS name sets SITE_SCHEME=https to re-enable Caddy auto-HTTPS / Let's
# Encrypt. deploy.sh picks the scheme automatically from the --domain value.
{$SITE_SCHEME:http}://{$SITE_DOMAIN:localhost} {
    encode gzip

    handle /api/method/konsol.cube_proxy/* {
        reverse_proxy cubejs:4000
    }

    # Excel Online hosts the add-in in an iframe on *.office.com — allow framing
    # and drop any X-Frame-Options Frappe may send on static add-in assets.
    @excel_addin_pane path /assets/konsol/excel-addin/index.html /assets/konsol/excel-addin/functions.js
    handle @excel_addin_pane {
        reverse_proxy frappe_backend:8069 {
            header_up Host {$SITE_NAME:konsolidat.local}
            header_down -X-Frame-Options -Content-Security-Policy -Cache-Control
        }
        header {
            Content-Security-Policy "frame-ancestors *"
            Access-Control-Allow-Origin "*"
            Cache-Control "no-cache, no-store, must-revalidate"
            -X-Frame-Options
        }
    }

    @excel_addin_meta path /assets/konsol/excel-addin/functions.json
    handle @excel_addin_meta {
        reverse_proxy frappe_backend:8069 {
            header_up Host {$SITE_NAME:konsolidat.local}
            header_down -X-Frame-Options -Content-Security-Policy -Cache-Control
        }
        header {
            Content-Security-Policy "frame-ancestors *"
            Access-Control-Allow-Origin "*"
            # Excel web caches functions.json for custom-function name registration.
            Cache-Control "public, max-age=300"
            -X-Frame-Options
        }
    }

    @excel_addin path /assets/konsol/excel-addin/*
    handle @excel_addin {
        reverse_proxy frappe_backend:8069 {
            header_up Host {$SITE_NAME:konsolidat.local}
            header_down -X-Frame-Options -Content-Security-Policy -Cache-Control
        }
        header {
            Content-Security-Policy "frame-ancestors *"
            Access-Control-Allow-Origin "*"
            Cache-Control "public, max-age=300"
            -X-Frame-Options
        }
    }

    handle {
        reverse_proxy frappe_backend:8069 {
            header_up Host {$SITE_NAME:konsolidat.local}
        }
    }
}

# Cube.js playground (optional, disable in production)
{$SITE_SCHEME:http}://{$SITE_DOMAIN:localhost}:4443 {
    reverse_proxy cubejs:4000
}
