# Template. DEMO_SITE and UPSTREAM come from the Caddy process environment.
# Do not commit a host name or an address. While `demo.sh reset` runs, the
# backend is stopped and the proxy error becomes the maintenance page below.
https://{$DEMO_SITE} {
	encode gzip
	handle {
		reverse_proxy {$UPSTREAM} {
			header_up Host {$DEMO_SITE}
		}
	}
	handle_errors {
		@down expression `{err.status_code} in [502, 503, 504]`
		handle @down {
			header Retry-After 120
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
				<!doctype html><meta charset="utf-8"><title>Konsolidat demo</title>
				<style>body{font:16px/1.5 system-ui,sans-serif;max-width:36em;margin:15vh auto;padding:0 1em;color:#222}</style>
				<h1>Back in a few minutes</h1>
				<p>The demo resets to its starting point at the top of every hour. The restore takes about two minutes; reload after that.</p>
				HTML 503
		}
	}
}
