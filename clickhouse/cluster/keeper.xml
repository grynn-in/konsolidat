<!--
  keeper.xml — ClickHouse Keeper configuration (embedded, co-located with CH)

  ClickHouse Keeper replaces ZooKeeper for coordination.  Run one Keeper
  instance per ClickHouse shard node for a 3-node cluster (quorum = 2).
  A standalone 3-node Keeper quorum is also supported and recommended for
  production — see the "Standalone Keeper" note below.

  Mount at:
    /etc/clickhouse-server/config.d/keeper.xml

  on EVERY node in the cluster, adjusting <server_id> to match the node.

  Substitute {KEEPER_HOST_1..3} with real hostnames or IPs.

  NEEDS-A-CLUSTER: Cannot be tested on a single-node setup.

  Co-located Keeper (3 nodes)
  ───────────────────────────
  Each ClickHouse node also runs a Keeper instance.
  server_id = 1 on ch-shard1, 2 on ch-shard2, 3 on ch-shard3.

  Standalone Keeper (recommended for production)
  ──────────────────────────────────────────────
  Run 3 dedicated Keeper nodes (no ClickHouse on them).
  Start clickhouse-keeper with its config at /etc/clickhouse-keeper/keeper.xml
  Adjust <server_id> and remove this config from ClickHouse nodes.
-->
<clickhouse>
  <keeper_server>
    <!--
      Unique ID for THIS node in the Keeper raft group — MUST match this node's
      <id> in <raft_configuration> below (ch-shard1=1, ch-shard2=2, ch-shard3=3).
      Read from the KEEPER_SERVER_ID env var (set per node in
      docker-compose.cluster.yml = SHARD_ID) so the SAME mounted keeper.xml gives
      each node a distinct id — previously hardcoded 1 on every node, which breaks
      the raft quorum (all nodes claim id 1). See grynn-in/konsolidat#57.
    -->
    <server_id from_env="KEEPER_SERVER_ID">1</server_id>

    <listen_host>0.0.0.0</listen_host>
    <!-- Raft port: Keeper → Keeper communication -->
    <raft_configuration>
      <server>
        <id>1</id>
        <hostname>ch-shard1</hostname>
        <port>9181</port>
      </server>
      <server>
        <id>2</id>
        <hostname>ch-shard2</hostname>
        <port>9181</port>
      </server>
      <server>
        <id>3</id>
        <hostname>ch-shard3</hostname>
        <port>9181</port>
      </server>
    </raft_configuration>

    <!-- ZooKeeper-compatible client port (used by ClickHouse MergeTree engine) -->
    <tcp_port>2181</tcp_port>

    <!-- Keeper data / log storage -->
    <log_storage_path>/var/lib/clickhouse-keeper/log</log_storage_path>
    <snapshot_storage_path>/var/lib/clickhouse-keeper/snapshots</snapshot_storage_path>

    <coordination_settings>
      <operation_timeout_ms>10000</operation_timeout_ms>
      <session_timeout_ms>30000</session_timeout_ms>
      <raft_logs_level>warning</raft_logs_level>
    </coordination_settings>
  </keeper_server>

  <!--
    Tell ClickHouse where to find Keeper for ReplicatedMergeTree coordination.
    Replace with <zookeeper><node><host>keeper-host</host>... if using a
    standalone cluster.
  -->
  <zookeeper>
    <node>
      <host>ch-shard1</host>
      <port>2181</port>
    </node>
    <node>
      <host>ch-shard2</host>
      <port>2181</port>
    </node>
    <node>
      <host>ch-shard3</host>
      <port>2181</port>
    </node>
  </zookeeper>
</clickhouse>
