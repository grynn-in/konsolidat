# =============================================================================
# Konsolidat — Environment Configuration
# =============================================================================
# deploy.sh auto-generates this with random passwords on first run.
# You can also copy manually:  cp .env.example .env
# =============================================================================

# --- Frappe ---
ADMIN_PASSWORD=admin123
SITE_NAME=konsolidat.local
FRAPPE_PORT=8069
FRAPPE_BRANCH=version-15

# --- MariaDB ---
DB_ROOT_PASSWORD=rootpassword

# --- ClickHouse ---
CLICKHOUSE_USER=default
# Placeholder only — deploy.sh overwrites this with a random secret on first run.
# docker-compose now REQUIRES this to be set (no insecure default).
CLICKHOUSE_PASSWORD=open_epm_dev
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
EXCEL_ODBC_PORT=15432
# Host interface the ClickHouse ports bind to. Loopback by default so the DB is
# not publicly exposed; set 0.0.0.0 only with TLS + a strong password in place.
CLICKHOUSE_BIND=127.0.0.1
# dbt ClickHouse transport is chosen by target: `dev` (plaintext loopback,
# default) or `prod` (TLS). Set DBT_TARGET=prod for any networked deployment.
# The konsol app's own ClickHouse TLS is configured separately in EPM Settings.
DBT_TARGET=dev

# --- Cube.js ---
CUBEJS_PORT=4000
CUBEJS_API_SECRET=CHANGE_ME_run_deploy_sh
CUBEJS_DEV_MODE=false

# --- Caddy reverse proxy ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Domain (optional — enables auto-SSL via Caddy) ---
SITE_DOMAIN=localhost
# http (default) serves plain HTTP — correct for localhost / IP / LAN / VM
# deploys (a bare host or IP makes Caddy issue a browser-rejected internal cert).
# Set https for a real DNS hostname to enable Caddy auto-HTTPS / Let's Encrypt.
# deploy.sh sets this automatically based on the --domain value.
SITE_SCHEME=http

# --- Backup ---
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./backups
# BACKUP_S3_BUCKET=your-bucket-name

# --- Konsol App (optional — override repo/branch) ---
# KONSOL_REPO=https://github.com/grynn-in/konsol.git
# KONSOL_BRANCH=main

# --- D365 Finance & Operations (optional — for real ERP data) ---
# Configure these in Frappe UI → EPM Settings after deployment
# D365_TENANT_ID=your-tenant-id
# D365_CLIENT_ID=your-client-id
# D365_CLIENT_SECRET=your-client-secret
# D365_ENVIRONMENT_URL=https://your-env.sandbox.operations.dynamics.com

# --- Airbyte (optional — second stack, installed via scripts/setup-airbyte.sh) ---
# Airbyte installs into its own local Kubernetes (kind) cluster; the setup script
# bridges that cluster to the 'open_epm' Docker network so sync pods can reach
# ClickHouse. Use ClickHouse's pinned IP (172.30.0.10:8123) as the destination
# host — pods cannot resolve the container name. Login creds: `abctl local credentials`.
# AIRBYTE_API_URL=http://localhost:8000
