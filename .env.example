# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=open_epm_dev
CLICKHOUSE_DB=epm

# Airbyte (runs via abctl, NOT in Docker Compose)
AIRBYTE_API_URL=http://localhost:8000
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password

# D365 OData
D365_TENANT_ID=your-tenant-id
D365_CLIENT_ID=your-client-id
D365_CLIENT_SECRET=your-client-secret
D365_ENVIRONMENT_URL=https://your-env.operations.dynamics.com

# Cube
CUBEJS_DB_TYPE=clickhouse
CUBEJS_DB_HOST=clickhouse
CUBEJS_DB_PORT=8123
CUBEJS_DB_USER=default
CUBEJS_DB_PASS=open_epm_dev
CUBEJS_DB_NAME=epm_gold
CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=your-cube-api-secret
CUBEJS_SQL_PORT=15432
CUBEJS_SQL_USER=epm_excel
CUBEJS_SQL_PASSWORD=epm_excel_password

# FastAPI
API_HOST=0.0.0.0
API_PORT=8080

# Dagster
DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_PG_HOST=dagster_postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=dagster_dev
DAGSTER_PG_DB=dagster

# Streamlit
STREAMLIT_PORT=8501
