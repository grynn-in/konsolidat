# =============================================================================
# Open EPM — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- ClickHouse (required — defaults work for local dev) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=open_epm_dev
CLICKHOUSE_DB=epm

# --- D365 Finance & Operations (required for real data) ---
# Get these from your Azure AD app registration
D365_TENANT_ID=your-tenant-id
D365_CLIENT_ID=your-client-id
D365_CLIENT_SECRET=your-client-secret
D365_ENVIRONMENT_URL=https://your-env.sandbox.operations.dynamics.com

# --- Airbyte (runs via abctl, NOT in Docker Compose) ---
# Local Airbyte instance URL (default works for abctl)
AIRBYTE_API_URL=http://localhost:8000
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password

# --- Airbyte Cloud (optional — use instead of local Airbyte) ---
# AIRBYTE_CLOUD_API_KEY=your-airbyte-cloud-api-key
# AIRBYTE_CLOUD_WORKSPACE_ID=your-workspace-id
